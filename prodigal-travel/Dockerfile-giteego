# ==========================================
# 阶段 1：Maven 构建阶段
# ==========================================
# 1. 使用阿里云的 Maven 基础镜像（极速拉取）
FROM registry.cn-hangzhou.aliyuncs.com/library/maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /build

# 2. 配置阿里云 Maven 镜像源（极速拉取依赖）
RUN mkdir -p /root/.m2 && \
    echo '<settings><mirrors><mirror><id>aliyunmaven</id><mirrorOf>central</mirrorOf><url>https://maven.aliyun.com/repository/public</url></mirror></mirrors></settings>' > /root/.m2/settings.xml

# 3. 复制根目录的 pom.xml 和子模块的 pom.xml
# 注意：此 Dockerfile 要求构建上下文（Context）必须是仓库根目录！
COPY pom.xml ./
COPY prodigal-travel/pom.xml ./prodigal-travel/pom.xml

# 4. 预下载依赖（利用 Docker 层缓存，如果 pom.xml 没变，这步会秒过）
RUN mvn -pl prodigal-travel -am dependency:go-offline -B

# 5. 复制源码并打包
COPY prodigal-travel ./prodigal-travel
RUN mvn -pl prodigal-travel -am clean package -DskipTests -B

# ==========================================
# 阶段 2：运行环境阶段
# ==========================================
# 6. 使用阿里云的 JRE 基础镜像
FROM registry.cn-hangzhou.aliyuncs.com/library/eclipse-temurin:21-jre-jammy
WORKDIR /app

# 7. 替换 Ubuntu 的 apt 源为阿里云，配置 Node.js 国内源，安装 MCP
# 注意：原版的 sed 替换对某些 Ubuntu 版本可能失效，加了 || true 防止报错阻断
RUN sed -i 's@//.*archive.ubuntu.com@//mirrors.aliyun.com@g; s@//.*security.ubuntu.com@//mirrors.aliyun.com@g' /etc/apt/sources.list || true \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm config set registry https://registry.npmmirror.com \
    && npm install -g @amap/amap-maps-mcp-server \
    && node -v \
    && npm -v \
    && rm -rf /var/lib/apt/lists/*

# 8. 从构建阶段复制打好的 jar 包
COPY --from=builder /build/prodigal-travel/target/*.jar /app/app.jar

EXPOSE 8088

ENV TZ=Asia/Shanghai \
    JAVA_TOOL_OPTIONS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom"

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl -sf -X POST http://127.0.0.1:8088/api/health/check | grep -q OK || exit 1

ENTRYPOINT ["java", "-jar", "/app/app.jar", "--spring.profiles.active=prod"]