# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交。
# 变量名与 application*.yml 中的 ${...} 占位符一一对应。
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=prod

# ===== MySQL =====
MYSQL_HOST=replace-me
SPRING_DATASOURCE_URL=jdbc:mysql://replace-me:3306/prodigal_ai_travel?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=replace-me
SPRING_DATASOURCE_PASSWORD=replace-me

# ===== PostgreSQL + pgvector（RAG，可选） =====
POSTGRESQL_HOST=replace-me
POSTGRESQL_USERNAME=replace-me
POSTGRESQL_PASSWORD=replace-me
# 也可直接给完整 JDBC URL，优先生效
# POSTGRESQL_URL=jdbc:postgresql://replace-me:5432/vector_db

# ===== Redis =====
SPRING_DATA_REDIS_HOST=replace-me
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_DATABASE=1

# ===== 大模型 =====
MINIMAX_API_KEY=replace-me
MINIMAX_CHAT_MODEL=MiniMax-M2.7
DASHSCOPE_API_KEY=replace-me
DASHSCOPE_CHAT_MODEL=qwen3.6-plus
DASHSCOPE_ENABLE_THINKING=true

# ===== 工具 / 第三方 API =====
PRODIGAL_SEARCH_API_API_KEY=replace-me
PRODIGAL_AMAP_API_KEY=replace-me
PRODIGAL_PEXELS_API_KEY=replace-me
PRODIGAL_BAIDU_APP_ID=replace-me
PRODIGAL_BAIDU_API_KEY=replace-me

# ===== MCP 客户端 =====
# 本地缺少 npx 或 MCP server jar 时设为 false
SPRING_AI_MCP_CLIENT_ENABLED=false
SPRING_AI_MCP_CLIENT_REQUEST_TIMEOUT=180000
# Windows 用 npx.cmd，Linux/macOS 用 npx
MCP_AMAP_COMMAND=npx
# 自研 stdio MCP server 的 jar 路径
# PRODIGAL_MCP_SERVER_JAR=../prodigal-ai-mcp-server/target/prodigal-ai-mcp-server-0.0.1.jar

# ===== Agent 线程池 =====
PRODIGAL_AGENT_POOL_SIZE=6
PRODIGAL_AGENT_QUEUE_CAPACITY=48

# ===== 认证 =====
PRODIGAL_JWT_SECRET=replace-me-with-at-least-32-chars
PRODIGAL_JWT_EXPIRE_HOURS=24

# ===== 邮件 =====
SPRING_MAIL_HOST=smtp.qq.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-me
SPRING_MAIL_PASSWORD=replace-me

# ===== 告警 =====
PRODIGAL_AI_ALERT_ENABLED=false
PRODIGAL_AI_ALERT_RECIPIENTS=
PRODIGAL_AI_ALERT_COOLDOWN_MINUTES=30

# ===== RabbitMQ =====
RABBITMQ_ENABLED=true
RABBITMQ_HOST=replace-me
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=replace-me
RABBITMQ_PASSWORD=replace-me
RABBITMQ_VHOST=/
